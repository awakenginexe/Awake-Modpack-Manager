{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Awake Modpack Manager",
  "version": "1.3.4",
  "identifier": "io.github.awakenginexe.AwakeModpackManager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Awake Modpack Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#07101e",
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Awake Modpack Manager Contributors",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "helper-stage/": "core-host/windows-x64/",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../LICENSE": "LICENSE",
      "../licenses/LGPL-3.0.txt": "licenses/LGPL-3.0.txt",
      "../licenses/rust-crates.txt": "licenses/rust-crates.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerHooks": "./installer-hooks.nsh" }
    }
  }
}
